# ---- ROS 2 / colcon ----
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
build/
install/
log/
*.pyc
__pycache__/
.pytest_cache/

# ---- CMake ----
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# ---- Generated experiment output ----
# Raw rosbags and large intermediate data are NOT versioned.
results/**/*.bag
results/**/*.db3
results/**/*.mcap
# `results/**/raw/*` and not `results/**/raw/`: git will not descend into an
# excluded DIRECTORY, so a trailing-slash rule makes the negations below
# unreachable and silently drops the per-run metrics with the bulk data.
results/**/raw/*
experiments/**/raw/*
*.log

# Plots and benchmark tables ARE versioned (they are the deliverable):
!results/**/*.png
!results/**/*.csv
!results/**/*.md

# So are the per-run metrics under raw/. They are the RECORD -- every
# aggregate table and plot is derived from them, and `run_benchmark.py
# --aggregate-only` re-derives the report from them without touching the
# simulator. A clone without them cannot reproduce or correct a single number.
# They are also tiny: ~2 KB each.
!results/**/raw/*.json

# ---- Gazebo ----
.gazebo/
.gz/

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
*~
.DS_Store

# ---- Python venv ----
.venv/
venv/

# Phase 11 keeps every sweep run's METRICS (the record) and the aggregate
# plots, but not the per-run error/trajectory PNGs: there are two per run
# across ~90 runs, they overwrite each other between seeds of the same level,
# and every one of them is regenerable from the JSON beside it.
results/phase11/raw/*.png

# ---- Secrets ----
# .env holds a GitHub token. It was untracked but NOT ignored, which is one
# `git add -A` away from publishing the credential -- and this project uses
# `git add -A` routinely.
.env
.env.*
!.env.example
*.pem
*.key
