# ---- ROS 2 / colcon ----
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
build/
install/
log/
*.pyc
__pycache__/
.pytest_cache/

# ---- CMake ----
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# ---- Generated experiment output ----
# Raw rosbags and large intermediate data are NOT versioned.
results/**/*.bag
results/**/*.db3
results/**/*.mcap
results/**/raw/
experiments/**/raw/
*.log

# Plots and benchmark tables ARE versioned (they are the deliverable):
!results/**/*.png
!results/**/*.csv
!results/**/*.md

# ---- Gazebo ----
.gazebo/
.gz/

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
*~
.DS_Store

# ---- Python venv ----
.venv/
venv/

# Phase 11 keeps every sweep run's METRICS (the record) and the aggregate
# plots, but not the per-run error/trajectory PNGs: there are two per run
# across ~90 runs, they overwrite each other between seeds of the same level,
# and every one of them is regenerable from the JSON beside it.
results/phase11/raw/*.png
