<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arb_bringup</name>
  <version>0.1.0</version>
  <description>Top-level composition: launch files and parameter sets that wire the full sensing -> estimation -> mapping -> planning -> control pipeline together.</description>
  <maintainer email="aemin8343@gmail.com">Emin Ayhan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>arb_simulation</depend>
  <depend>arb_sensors</depend>
  <depend>arb_localization</depend>
  <depend>arb_mapping</depend>
  <depend>arb_planning</depend>
  <depend>arb_control</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
