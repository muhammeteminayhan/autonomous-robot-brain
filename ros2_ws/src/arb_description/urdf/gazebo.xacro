<?xml version="1.0"?>
<!--
  Gazebo Harmonic (gz-sim 8) specific blocks: surface properties, sensors and
  the systems that actuate the robot and publish its state.

  Noise parameters are read from configs/sensors.yaml. Gazebo's <noise> element
  wants a DISCRETE-TIME standard deviation, while a datasheet quotes a noise
  DENSITY in units per sqrt(Hz). The conversion is

      sigma_discrete = noise_density * sqrt(sample_rate)

  Getting this wrong by the sqrt(rate) factor (about 14x at 200 Hz) is a classic
  mistake: the simulated IMU then looks far cleaner or far dirtier than the part
  you are pretending to model, and every EKF tuning decision made against it is
  wrong. The arithmetic is done inline below so the datasheet numbers stay
  recognisable in the config file.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="imu_cfg"   value="${scfg['imu']}"/>
  <xacro:property name="lidar_cfg" value="${scfg['lidar']}"/>
  <xacro:property name="gt_cfg"    value="${scfg['ground_truth']}"/>

  <xacro:property name="imu_rate"    value="${imu_cfg['rate_hz']}"/>
  <xacro:property name="gyro"        value="${imu_cfg['gyroscope']}"/>
  <xacro:property name="accel"       value="${imu_cfg['accelerometer']}"/>
  <xacro:property name="gyro_sigma"  value="${gyro['noise_density_rad_s_sqrt_hz'] * imu_rate ** 0.5}"/>
  <xacro:property name="accel_sigma" value="${accel['noise_density_m_s2_sqrt_hz'] * imu_rate ** 0.5}"/>

  <!-- Bias is modelled as an Ornstein-Uhlenbeck process. The correlation time
       is how long the bias "remembers" its previous value; 300 s is typical for
       a MEMS part and is long enough that, over a 120 s experiment, the bias
       looks like a constant offset rather than extra white noise. That is
       exactly the regime an EKF struggles with, which is what we want to test. -->
  <xacro:property name="bias_correlation_time_s" value="300.0"/>

  <!-- One <noise> block per IMU axis. xacro:element makes the element NAME
       itself a parameter, so "x"/"y"/"z" come from the macro argument instead
       of three near-identical copy-pasted blocks that can silently drift. -->
  <xacro:macro name="gyro_axis" params="axis">
    <xacro:element xacro:name="${axis}">
      <noise type="gaussian">
        <mean>0.0</mean>
        <stddev>${gyro_sigma}</stddev>
        <bias_mean>${gyro['bias_stability_rad_s']}</bias_mean>
        <bias_stddev>${gyro['bias_stability_rad_s']}</bias_stddev>
        <dynamic_bias_stddev>${gyro['bias_random_walk_rad_s2']}</dynamic_bias_stddev>
        <dynamic_bias_correlation_time>${bias_correlation_time_s}</dynamic_bias_correlation_time>
      </noise>
    </xacro:element>
  </xacro:macro>

  <xacro:macro name="accel_axis" params="axis">
    <xacro:element xacro:name="${axis}">
      <noise type="gaussian">
        <mean>0.0</mean>
        <stddev>${accel_sigma}</stddev>
        <bias_mean>${accel['bias_stability_m_s2']}</bias_mean>
        <bias_stddev>${accel['bias_stability_m_s2']}</bias_stddev>
        <dynamic_bias_stddev>${accel['bias_random_walk_m_s3']}</dynamic_bias_stddev>
        <dynamic_bias_correlation_time>${bias_correlation_time_s}</dynamic_bias_correlation_time>
      </noise>
    </xacro:element>
  </xacro:macro>

  <!-- ==================== surface properties ==================== -->
  <!-- Wheels need high friction or they slip and the encoders lie. mu2 is the
       coefficient in the second (lateral) friction direction. -->
  <xacro:macro name="wheel_surface" params="link">
    <gazebo reference="${link}">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_surface link="left_wheel_link"/>
  <xacro:wheel_surface link="right_wheel_link"/>

  <!-- The caster must be nearly frictionless. A caster with wheel-like friction
       resists turning, the drive wheels scrub to overcome it, and that slip
       appears as a heading bias in the odometry: a fault we did not ask for and
       would waste hours chasing in Phase 3. -->
  <xacro:macro name="caster_surface" params="link">
    <gazebo reference="${link}">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>
  </xacro:macro>
  <xacro:caster_surface link="front_caster_link"/>
  <xacro:caster_surface link="rear_caster_link"/>

  <gazebo reference="base_link">
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>

  <!-- ==================== IMU ==================== -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>${imu_rate}</update_rate>
      <visualize>false</visualize>
      <topic>${imu_cfg['topic_raw'].lstrip('/')}</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <xacro:gyro_axis axis="x"/>
          <xacro:gyro_axis axis="y"/>
          <xacro:gyro_axis axis="z"/>
        </angular_velocity>
        <linear_acceleration>
          <xacro:accel_axis axis="x"/>
          <xacro:accel_axis axis="y"/>
          <xacro:accel_axis axis="z"/>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ==================== 2D LiDAR ==================== -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <always_on>1</always_on>
      <update_rate>${lidar_cfg['rate_hz']}</update_rate>
      <visualize>true</visualize>
      <topic>${lidar_cfg['topic_raw'].lstrip('/')}</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>${lidar_cfg['samples']}</samples>
            <resolution>1</resolution>
            <min_angle>${lidar_cfg['angle_min_rad']}</min_angle>
            <max_angle>${lidar_cfg['angle_max_rad']}</max_angle>
          </horizontal>
          <!-- A single vertical sample: this is a planar 2D scanner. -->
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>${lidar_cfg['range_min_m']}</min>
          <max>${lidar_cfg['range_max_m']}</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>${lidar_cfg['range_noise_sigma_m']}</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ==================== systems ==================== -->
  <gazebo>
    <!-- Actuation. Consumes /cmd_vel and applies wheel torques.
         NOTE: DiffDrive can also publish its own odometry. We route that to an
         unbridged topic and never use it. Computing odometry from the wheel
         encoders is the entire point of Phase 3; taking Gazebo's version would
         skip the work and hide every modelling error we want to study. -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${drive['wheel_separation_m']}</wheel_separation>
      <wheel_radius>${drive['wheel_radius_m']}</wheel_radius>
      <max_linear_acceleration>${drive['max_linear_acceleration_m_s2']}</max_linear_acceleration>
      <min_linear_acceleration>${-drive['max_linear_acceleration_m_s2']}</min_linear_acceleration>
      <max_angular_acceleration>${drive['max_angular_acceleration_rad_s2']}</max_angular_acceleration>
      <min_angular_acceleration>${-drive['max_angular_acceleration_rad_s2']}</min_angular_acceleration>
      <max_linear_velocity>${drive['max_linear_velocity_m_s']}</max_linear_velocity>
      <min_linear_velocity>${drive['min_linear_velocity_m_s']}</min_linear_velocity>
      <max_angular_velocity>${drive['max_angular_velocity_rad_s']}</max_angular_velocity>
      <min_angular_velocity>${-drive['max_angular_velocity_rad_s']}</min_angular_velocity>
      <topic>cmd_vel</topic>
      <odom_topic>gz_internal/diff_drive_odom</odom_topic>
      <tf_topic>gz_internal/diff_drive_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>1</odom_publish_frequency>
    </plugin>

    <!-- Wheel encoders. JointStatePublisher reports joint position (accumulated
         wheel angle, rad) and velocity (rad/s), which is exactly what a
         quadrature encoder gives after decoding. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <update_rate>${scfg['wheel_encoder']['rate_hz']}</update_rate>
    </plugin>

    <!-- GROUND TRUTH. EVALUATION ONLY.
         OdometryPublisher derives its output from the model's true world pose,
         so this is the robot's exact state. It is bridged into ROS purely so
         arb_evaluation can compute error metrics. No estimation, mapping,
         planning or control node may subscribe to it; the rule is enforced by
         tests/integration/test_ground_truth_isolation.py. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>${gt_cfg['rate_hz']}</odom_publish_frequency>
      <dimensions>2</dimensions>
      <odom_topic>ground_truth/odom</odom_topic>
      <tf_topic>gz_internal/ground_truth_tf</tf_topic>
    </plugin>
  </gazebo>

</robot>
